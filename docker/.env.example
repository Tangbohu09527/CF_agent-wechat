# CF_wechat-lab deployment values.
# Copy this file to .env on the target host. Do not place secrets here.

COMPOSE_PROJECT_NAME=cf-wechat-lab
# Resolve the 0.11.15 tag as documented in README.md, then replace this value.
AGENT_WECHAT_IMAGE=ghcr.io/thisnick/agent-wechat@sha256:REPLACE_WITH_VERIFIED_DIGEST
AGENT_WECHAT_CONTAINER_NAME=cf-agent-wechat-lab

# Bind to loopback because the upstream service has no TLS. Use an SSH tunnel
# from a trusted workstation. Direct LAN binding requires a separate review.
AGENT_WECHAT_BIND_IP=127.0.0.1
AGENT_WECHAT_PORT=6174

# Keep enabled for lab inspection through http://127.0.0.1:6174/vnc/
# after establishing the SSH tunnel described in README.md.
ENABLE_VNC=1
RUST_LOG=info

# Leave empty for the first V1 test. Enabling a transparent proxy also requires
# adding NET_ADMIN to cap_add after a separate security review.
PROXY=
