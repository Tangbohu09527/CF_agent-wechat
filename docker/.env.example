# Production management values. Bootstrap validates docker/.env as mode 0600 with
# the approved owner, or mode 0640 with the approved management group.
# Never place the API auth Token or QR data in this file.

COMPOSE_PROJECT_NAME=cf-agent-wechat
AGENT_WECHAT_IMAGE=ghcr.io/thisnick/agent-wechat@sha256:REPLACE_WITH_64_HEX_DIGEST
AGENT_WECHAT_CONTAINER_NAME=cf-agent-wechat

CF_AGENT_WECHAT_STORAGE_ROOT=/srv/storage/cf-agent-wechat
CF_AGENT_WECHAT_RUNTIME_ROOT=/srv/storage/cf-agent-wechat/runtime
CF_AGENT_WECHAT_ARCHIVE_ROOT=/srv/storage/cf-agent-wechat/session-archive

# Fresh runtimes must use this exact non-root ownership and private mode.
CF_AGENT_WECHAT_RUNTIME_UID=1000
CF_AGENT_WECHAT_RUNTIME_GID=1000
CF_AGENT_WECHAT_RUNTIME_MODE=700
CF_AGENT_WECHAT_MANAGEMENT_GID=1000

# Fresh QR fails closed before archive mutation when any threshold is unmet.
CF_AGENT_WECHAT_MIN_FREE_BYTES=1073741824
CF_AGENT_WECHAT_MIN_FREE_PERCENT=10
CF_AGENT_WECHAT_MIN_FREE_INODES=1024

# Runtime Token scans are bounded by both entry count and total regular-file bytes.
CF_AGENT_WECHAT_TOKEN_SCAN_MAX_FILES=200000
CF_AGENT_WECHAT_TOKEN_SCAN_MAX_BYTES=21474836480

AGENT_WECHAT_BIND_IP=127.0.0.1
AGENT_WECHAT_PORT=6174

# The production Compose disables VNC regardless of this environment file.
PROXY=
RUST_LOG=info
